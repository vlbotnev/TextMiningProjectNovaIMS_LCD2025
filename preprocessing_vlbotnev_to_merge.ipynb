    "# === 2.6 Lemmatization (NLTK Approach - Course Compliant) ===\n",
    "\n",
    "import nltk\n",
    "from nltk.stem import WordNetLemmatizer\n",
    "from nltk.corpus import wordnet\n",
    "\n",
    "# 1. FORCE DOWNLOADS (Без проверок, чтобы гарантировать наличие файлов)\n",
    "print(\"Downloading NLTK resources...\")\n",
    "nltk.download(\"averaged_perceptron_tagger\", quiet=True)\n",
    "nltk.download(\"averaged_perceptron_tagger_eng\", quiet=True)  # Для новых версий NLTK\n",
    "nltk.download(\"wordnet\", quiet=True)\n",
    "nltk.download(\"omw-1.4\", quiet=True)\n",
    "print(\"Resources downloaded.\")\n",
    "\n",
    "# Initialize Lemmatizer\n",
    "lemmatizer = WordNetLemmatizer()\n",
    "\n",
    "\n",
    "# Helper function to map NLTK POS tags to WordNet POS tags\n",
    "def get_wordnet_pos(nltk_tag):\n",
    "    if nltk_tag.startswith(\"J\"):\n",
    "        return wordnet.ADJ\n",
    "    elif nltk_tag.startswith(\"V\"):\n",
    "        return wordnet.VERB\n",
    "    elif nltk_tag.startswith(\"N\"):\n",
    "        return wordnet.NOUN\n",
    "    elif nltk_tag.startswith(\"R\"):\n",
    "        return wordnet.ADV\n",
    "    else:\n",
    "        return wordnet.NOUN  # Default to Noun\n",
    "\n",
    "\n",
    "def nltk_lemmatize(text):\n",
    "    # 1. Tokenize (we can use split since we already cleaned punctuation)\n",
    "    tokens = text.split()\n",
    "\n",
    "    if not tokens:\n",
    "        return \"\"\n",
    "\n",
    "    # 2. POS Tagging (Essential for correct lemmatization: 'meeting' -> noun vs verb)\n",
    "    try:\n",
    "        # Стандартный вызов\n",
    "        pos_tags = nltk.pos_tag(tokens)\n",
    "    except LookupError:\n",
    "        # Если вдруг упадет, пробуем явно указать язык (для новых версий)\n",
    "        try:\n",
    "            pos_tags = nltk.pos_tag(tokens, lang=\"eng\")\n",
    "        except:\n",
    "            # Fallback: если совсем все плохо, считаем все существительными\n",
    "            # Это спасет код от падения, хоть и ухудшит лемматизацию\n",
    "            return \" \".join([lemmatizer.lemmatize(t) for t in tokens])\n",
    "\n",
    "    # 3. Lemmatize based on POS tag\n",
    "    lemmatized_tokens = [\n",
    "        lemmatizer.lemmatize(word, get_wordnet_pos(tag)) for word, tag in pos_tags\n",
    "    ]\n",
    "\n",
    "    return \" \".join(lemmatized_tokens)\n",
    "\n",
    "\n",
    "print(\"Starting NLTK Lemmatization on 'text_for_clf'...\")\n",
    "# Note: NLTK is slower than spaCy. This might take 1-2 minutes.\n",
    "atlanta_rest[\"text_for_clf\"] = atlanta_rest[\"text_for_clf\"].apply(nltk_lemmatize)\n",
    "\n",
    "print(\"Lemmatization complete.\")\n",
    "\n",
    "# Verification\n",
    "print(\"Verification:\")\n",
    "sample = atlanta_rest.sample(1, random_state=42)\n",
    "print(f\"Original Clean: {sample['clean_text'].values[0][:100]}...\")\n",
    "print(f\"NLTK Lemma:     {sample['text_for_clf'].values[0][:100]}...\")"
   ]
