    "from sklearn.feature_extraction.text import CountVectorizer\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Set visual style\n",
    "sns.set_style(\"whitegrid\")\n",
    "\n",
    "\n",
    "def plot_top_ngrams(corpus, n=1, top_k=15, title=\"Top N-grams\"):\n",
    "    \"\"\"\n",
    "    Plots the most frequent n-grams (1 word or 2 words) excluding standard English stopwords.\n",
    "    \"\"\"\n",
    "    # Initialize Vectorizer with standard English stopwords to see meaningful content\n",
    "    vec = CountVectorizer(ngram_range=(n, n), stop_words=\"english\").fit(corpus)\n",
    "\n",
    "    # Get counts\n",
    "    bag_of_words = vec.transform(corpus)\n",
    "    sum_words = bag_of_words.sum(axis=0)\n",
    "\n",
    "    # Create list of (word, count)\n",
    "    words_freq = [(word, sum_words[0, idx]) for word, idx in vec.vocabulary_.items()]\n",
    "    words_freq = sorted(words_freq, key=lambda x: x[1], reverse=True)[:top_k]\n",
    "\n",
    "    # Prepare DataFrame for plotting\n",
    "    df_ngram = pd.DataFrame(words_freq, columns=[\"Ngram\", \"Count\"])\n",
    "\n",
    "    # Plot\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    sns.barplot(x=\"Count\", y=\"Ngram\", data=df_ngram, palette=\"viridis\")\n",
    "    plt.title(title)\n",
    "    plt.xlabel(\"Frequency\")\n",
    "    plt.ylabel(\"Terms\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "# 1. Inspect Top Unigrams (Single words)\n",
    "# Helps identify domain-specific stopwords (e.g., 'food', 'place' might be too generic)\n",
    "plot_top_ngrams(\n",
    "    atlanta_rest[\"raw_content\"], n=1, title=\"Top 15 Unigrams (Single Words)\"\n",
    ")\n",
    "\n",
    "# 2. Inspect Top Bigrams (Word pairs)\n",
    "# Helps identify entities that shouldn't be split (e.g., 'fried chicken', 'happy hour')\n",
    "plot_top_ngrams(atlanta_rest[\"raw_content\"], n=2, title=\"Top 15 Bigrams (Word Pairs)\")"
   ],
