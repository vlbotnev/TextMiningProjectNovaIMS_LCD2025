   "cell_type": "code",
   "source": [
    "from gensim.models.doc2vec import Doc2Vec, TaggedDocument\n",
    "# 1. Split the text data first\n",
    "X_train_text, X_test_text, y_train, y_test = train_test_split(\n",
    "    atlanta_rest[\"processed_text\"], \n",
    "    atlanta_rest[\"categoryName\"], \n",
    "    test_size=0.2, \n",
    "    random_state=42\n",
    ")\n",
    "# 2. Prepare training data for Doc2Vec\n",
    "# Doc2Vec requires a list of TaggedDocument objects (tokens + unique ID)\n",
    "train_tagged = [\n",
    "    TaggedDocument(words=str(text).split(), tags=[i]) \n",
    "    for i, text in enumerate(X_train_text)\n",
    "]\n",
    "\n",
    "# 3. Initialize and train the Doc2Vec model\n",
    "# vector_size: Dimension of the output vectors (100-300 is common)\n",
    "# min_count: Ignores all words with total frequency lower than this\n",
    "# epochs: Number of iterations over the corpus\n",
    "model_d2v = Doc2Vec(vector_size=100, min_count=2, epochs=40, workers=4)\n",
    "\n",
    "print(\"Building vocabulary...\")\n",
    "model_d2v.build_vocab(train_tagged)\n",
    "\n",
    "print(\"Training Doc2Vec model...\")\n",
    "model_d2v.train(train_tagged, total_examples=model_d2v.corpus_count, epochs=model_d2v.epochs)\n",
    "\n",
    "# 4. Generate vectors\n",
    "# For training data, we extract the learned vectors by tag index\n",
    "X_train = np.array([model_d2v.dv[i] for i in range(len(train_tagged))])\n",
    "\n",
    "# For test data, we infer vectors based on the trained model\n",
    "X_test = np.array([model_d2v.infer_vector(str(text).split()) for text in X_test_text])\n",
