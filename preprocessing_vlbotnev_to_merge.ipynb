    "import gensim.downloader as api\n",
    "import numpy as np\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "\n",
    "w2v_model = api.load('glove-wiki-gigaword-100')\n",
    "\n",
    "def document_vector(doc):\n",
    "\n",
    "    doc = str(doc).split()\n",
    "    words_vecs = [w2v_model[word] for word in doc if word in w2v_model]\n",
    "    \n",
    "    if len(words_vecs) == 0:\n",
    "        return np.zeros(100) \n",
    "    \n",
    "    return np.mean(words_vecs, axis=0)\n",
    "\n",
    "X_embeddings = np.array([document_vector(text) for text in atlanta_rest[\"processed_text\"]])\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X_embeddings, \n",
    "    atlanta_rest[\"categoryName\"], \n",
    "    test_size=0.2, \n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "print(\"Shape:\", X_train.shape)"
